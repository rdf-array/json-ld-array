    owl:equivalentClass [ rdf:type owl:Class ;
                          owl:intersectionOf ( snomedct:Disorder_by_body_site-disorder
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty snomedct:role_group-attr ;
                                                 owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                      owl:onProperty snomedct:Finding_site-attr ;
                                                                      owl:someValuesFrom snomedct:Structure_of_musculoskeletal_system-body
                                                                    ]
                                               ]
                                             )
                        ] ;
    sctf:Description.term.en-us.synonym "Musculoskeletal disorder" ;
    sctf:Description.term.en-us.preferred "Disorder of musculoskeletal system" .

