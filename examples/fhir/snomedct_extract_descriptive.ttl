# Anatomy

snomedct:Body_structure-body 
    a owl:Class ;
    rdfs:label "Body structure (body structure)" ; snomedct:code "123037004" ;
    rdfs:subClassOf snomedct:SNOMED_CT_CONCEPT ;
    sctf:Description.term.en-us.synonym "Body structures" ;
    sctf:Description.term.en-us.preferred "Body structure" .

snomedct:Anatomical_or_acquired_body_structure-body 
    a owl:Class ;
    rdfs:label "Anatomical or acquired body structure (body structure)" ; snomedct:code "442083009" ;
    rdfs:subClassOf snomedct:Body_structure-body ;
    sctf:Description.term.en-us.preferred "Anatomical or acquired body structure" .

snomedct:Anatomical_structure-body 
    a owl:Class ;
    rdfs:label "Anatomical structure (body structure)" ; snomedct:code "91723000" ;
    rdfs:subClassOf snomedct:Anatomical_or_acquired_body_structure-body ;
    sctf:Description.term.en-us.preferred "Anatomical structure" .

snomedct:Body_organ_structure-body 
    a owl:Class ;
    rdfs:label "Body organ structure (body structure)" ; snomedct:code "113343008" ;
    rdfs:subClassOf snomedct:Anatomical_structure-body ;
    sctf:Description.term.en-us.synonym "Body organ" ;
    sctf:TextDefinition.term "An anatomical structure that consists of the maximal set of organ parts so connected to one another that together they constitute a self-contained unit of macroscopic anatomy, distinct both morphologically and functionally from other such units. Together with other organs, an organ constitutes an organ system or a body part. An organ is divisible into organ parts but not organs (examples: femur, biceps, liver, heart, aorta, sciatic nerve, ovary)." ;
    sctf:Description.term.en-us.preferred "Body organ structure" .

snomedct:Body_structure_altered_from_its_original_anatomical_structure-morph 
    a owl:Class ;
    rdfs:label "Body structure, altered from its original anatomical structure (morphologic abnormality)" ; snomedct:code "118956008" ;
    rdfs:subClassOf snomedct:Body_structure-body ;
    sctf:Description.term.en-us.synonym "Body structure, altered from its original anatomical structure" ;
    sctf:Description.term.en-us.preferred "Morphologically altered structure" ;
    sctf:Description.term.en-us.synonym "Morphologic alteration" , "Morphologic change" .

snomedct:Morphologically_abnormal_structure-morph 
    a owl:Class ;
    rdfs:label "Morphologically abnormal structure (morphologic abnormality)" ; snomedct:code "49755003" ;
    rdfs:subClassOf snomedct:Body_structure_altered_from_its_original_anatomical_structure-morph ;
    sctf:Description.term.en-us.synonym "Abnormal tissue appearance" , "Lesion" ;
    sctf:Description.term.en-us.preferred "Morphologically abnormal structure" .

snomedct:Inflammatory_morphology-morph 
    a owl:Class ;
    rdfs:label "Inflammatory morphology (morphologic abnormality)" ; snomedct:code "409774005" ;
    rdfs:subClassOf snomedct:Morphologically_abnormal_structure-morph ;
    sctf:Description.term.en-us.preferred "Inflammatory morphology" .


snomedct:Disease-disorder 
    a owl:Class ;
    rdfs:label "Disease (disorder)" ; snomedct:code "64572001" ;
    rdfs:subClassOf snomedct:Clinical_finding-finding ;
    sctf:Description.term.en-us.synonym "Disorders" ;
    sctf:Description.term.en-us.preferred "Disease" ;
    sctf:Description.term.en-us.synonym "Diseases" , "Clinical disease AND/OR syndrome" , "Disorder" , "Syndrome" , "Disease AND/OR syndrome present" , "Clinical disease AND/OR syndrome present" .

snomedct:Disorder_by_body_site-disorder 
    a owl:Class ;
    rdfs:label "Disorder by body site (disorder)" ; snomedct:code "123946008" ;
    owl:equivalentClass [ rdf:type owl:Class ;
                          owl:intersectionOf ( snomedct:Disease-disorder
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty snomedct:role_group-attr ;
                                                 owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                      owl:onProperty snomedct:Finding_site-attr ;
                                                                      owl:someValuesFrom snomedct:Anatomical_or_acquired_body_structure-body 
                                                                    ]
                                               ]
                                             )
                        ] ;
    sctf:Description.term.en-us.preferred "Disorder by body site" .

snomedct:Inflammatory_disorder-disorder 
    a owl:Class ;
    rdfs:label "Inflammatory disorder (disorder)" ; snomedct:code "128139000" ;
    owl:equivalentClass [ rdf:type owl:Class ;
                          owl:intersectionOf ( snomedct:Disease-disorder
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty snomedct:role_group-attr ;
                                                 owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                      owl:onProperty snomedct:Associated_morphology-attr ;
                                                                      owl:someValuesFrom snomedct:Inflammatory_morphology-morph
                                                                    ]
                                               ]
                                             )
                        ] ;
    sctf:Description.term.en-us.preferred "Inflammatory disorder" ;
    sctf:Description.term.en-us.synonym "Inflammatory disease" .

snomedct:Family_history_Rheumatoid_arthritis-situation 
    a owl:Class ;
    rdfs:label "Family history: Rheumatoid arthritis (situation)" ; snomedct:code "160413008" ;
    owl:equivalentClass [ rdf:type owl:Class ;
                          owl:intersectionOf ( snomedct:Family_history_with_explicit_context-situation 
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty snomedct:role_group-attr ;
                                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                                      owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty snomedct:Associated_finding-attr ;
                                                                                             owl:someValuesFrom snomedct:Rheumatoid_arthritis-disorder 
                                                                                           ]
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty snomedct:Finding_context-attr ;
                                                                                             owl:someValuesFrom snomedct:Known_present-qual 
                                                                                           ]
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty snomedct:Temporal_context-attr ;
                                                                                             owl:someValuesFrom snomedct:Current_or_past-actual-qual 
                                                                                           ]
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty snomedct:Subject_relationship_context-attr ;
                                                                                             owl:someValuesFrom snomedct:Person_in_family_of_subject-person 
                                                                                           ]
                                                                                         )
                                                                    ]
                                               ]
                                             )
                        ] ;
    sctf:Description.term.en-us.preferred "FH: Rheumatoid arthritis" ;
    sctf:Description.term.en-us.synonym "Family history: Rheumatoid arthritis" .

