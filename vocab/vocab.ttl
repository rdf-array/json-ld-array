@prefix ra:   <https://rdf-array.github.io/rdf-array/vocab#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix mf:   <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .

# The rdf-array test vocabulary: what a test requires (mf:requires) and the JSON-LD-array test type.

ra:Sequences a mf:Requirement ;
    rdfs:label "Sequences" ;
    rdfs:comment "The sequence term: a syntax reads and writes ( e1 e2 … ) as one term, () the empty sequence." .

ra:SequencePatterns a mf:Requirement ;
    rdfs:label "SequencePatterns" ;
    rdfs:comment "SPARQL-array: a sequence term in a triple pattern, template or INSERT/DELETE DATA, with variables bound element by element." .

ra:SequenceResults a mf:Requirement ;
    rdfs:label "SequenceResults" ;
    rdfs:comment "SPARQL results carrying sequence terms: JSON {\"type\": \"seq\", \"value\": [ … ]}, XML <seq>, CSV and TSV spellings." .

ra:GapPatterns a mf:Requirement ;
    rdfs:label "GapPatterns" ;
    rdfs:comment "SPARQL-array: `...` in a sequence pattern matches any run of members, and `...?rest` binds that run. Proposed syntax (docs/array-syntax.md)." .

ra:Unnest a mf:Requirement ;
    rdfs:label "Unnest" ;
    rdfs:comment "SPARQL-array: UNNEST(expr AS ?x AT ?i), one solution per member of a sequence, with its 1-based position. Proposed syntax (docs/array-syntax.md)." .

ra:SequenceFunctions a mf:Requirement ;
    rdfs:label "SequenceFunctions" ;
    rdfs:comment "SPARQL-array functions isSEQ, SEQLEN and SEQ, the index expr[i], the slice expr[m...n] and `?x IN ?seq`. Proposed syntax (docs/array-syntax.md)." .

ra:ListShapeExpression a mf:Requirement ;
    rdfs:label "ListShapeExpression" ;
    rdfs:comment "ShEx-array LIST shape expression: LIST ( regex ) over the members, LIST * x, LIST + x, LIST {m,n} x; ShExJ {\"type\": \"ListShape\"}, ShExR sx:ListShape. Proposed syntax (docs/array-syntax.md)." .

ra:ShaclListConstraints a mf:Requirement ;
    rdfs:label "ShaclListConstraints" ;
    rdfs:comment "SHACL-array: SHACL 1.2's sh:memberShape, sh:minListLength, sh:maxListLength and sh:uniqueMembers over sequence values (a SHACL list is a sequence term)." .

ra:JsonLdArrayToRdfTest a rdfs:Class ;
    rdfs:label "JsonLdArrayToRdfTest" ;
    rdfs:comment "A JSON-LD-array test: plain JSON (input) and a mapping document (ra:mapping) to N-Quads-array (expect) or an error code (expectErrorCode)." .

ra:mapping a rdf:Property ;
    rdfs:label "mapping" ;
    rdfs:comment "The JSON-LD-array mapping document of a ra:JsonLdArrayToRdfTest." .
