   // Creates a list, collecting its (possibly blank) items and triples associated with those items
+  // A sequence is one term; its members' own triples come along unchanged
+  function createSeq(objects) {
+    var triples = [];
+    objects.forEach(function (o) { appendAllTo(triples, o.triples); });
+    return { entity: { termType: 'Seq', members: objects.map(function (o) { return o.entity; }) }, triples: triples };
+  }
+
   function createList(objects) {
     var list = blank(), head = list, listItems = [], listTriples, triples = [];
